DATA_DIR <- "report-agent/data/processed"

# calculate_stability_metrics_mlb <- function(input_file = NULL) {
  cat("Calculating MLB stability metrics...\n")
  
  if (is.null(input_file)) {
    input_file <- file.path(DATA_DIR, "loft_profile_classification.csv")
  }
  
  if (!file.exists(input_file)) {
    stop("Input file not found: ", input_file)
  }
  
  angles_data <- read.csv("report-agent/data/processed/loft_profile_classification.csv")
  cat("Loaded", nrow(angles_data), "MLB player-season records.\n")
  
  # Sort by player and season for transitions
  player_seasons <- angles_data %>%
    mutate(`High.AA.` = ifelse(!season %in% c(2025,2026),NA,`High.AA.`))
  
  # Create transitions
  transitions_list <- list()
  
  for (player_id in unique(player_seasons$last_first_name)) {
    player_data <- player_seasons %>%
      filter(last_first_name == player_id) %>%
      arrange(season)
    
    if (nrow(player_data) > 1) {
      for (i in 1:(nrow(player_data) - 1)) {
        prior <- player_data %>% dplyr::slice(i)
        current <- player_data %>% dplyr::slice(i + 1)
        
        transition <- tibble(
          batter = player_id,
          batter_name = prior$last_first_name,
          prior_year = prior$season,
          current_year = current$season,
          prior_poor_loft = prior$poor_loft,
          prior_loft_cohort = prior$loft_cohort,
          prior_angles_score = prior$angles_score,
          prior_angles_tier = prior$angles_tier,
          prior_interaction_cohort = prior$interaction_cohort,
          prior_swspt_cohort = prior$swspt_cohort,
          prior_ss_pct = prior$`Sweet.Spot.`,
          prior_ss_pct_rank = prior$sweet_spot_pct_rank,
          
          # YoY changes
          ss_pct_yoy_change = current$`Sweet.Spot.` - prior$`Sweet.Spot.`,
          ss_pct_yoy_change_rank = current$sweet_spot_pct_rank - prior$sweet_spot_pct_rank,
          la_avg_yoy_change = current$`Avg.LA` - prior$`Avg.LA`,
          oppo_fb_ev_yoy_change = current$`Oppo.FB.EV` - prior$`Oppo.FB.EV`,
          oppo_fb_pct_yoy_change = current$`Oppo.FB.` - prior$`Oppo.FB.`,
          hhla_yoy_change = current$`HH.LA` - prior$`HH.LA`,
          ideal_aa_yoy_change = current$`High.AA.` - prior$`High.AA.`,
          
          current_ss_pct = current$`Sweet.Spot.`,
          current_ss_pct_rank = current$sweet_spot_pct_rank,
          current_angles_score = current$angles_score,
          current_interaction_cohort = current$interaction_cohort,
          current_swspt_cohort = current$swspt_cohort,
          current_loft_cohort = current$loft_cohort,
          
          # Indicators - Sweet Spot regression
          regressed_ss_5pp = if_else(ss_pct_yoy_change < -2.5, 1, 0),
          regressed_ss_10pp = if_else(ss_pct_yoy_change < -5, 1, 0),
          improved_ss_5pp = if_else(ss_pct_yoy_change > 2.5, 1, 0),
          stayed_good_ss = if_else(current$sweet_spot_pct_rank >= 65,1,0),
          
          # Indicators - Angles Score regression
          angles_score_yoy_change = current_angles_score - prior_angles_score,
          regressed_angles_score = if_else(angles_score_yoy_change < -0.05, 1, 0),
          improved_angles_score = if_else(angles_score_yoy_change > 0.05, 1, 0),
          stayed_good_angles = if_else(current_angles_score >= 0.5025,1,0)
        )
        
        transitions_list[[length(transitions_list) + 1]] <- transition
      }
    }
  }
  
  if (length(transitions_list) > 0) {
    transitions_df <- bind_rows(transitions_list)
    cat("\nIdentified", nrow(transitions_df), "MLB year-over-year transitions.\n")
    
    write_csv(transitions_df, "report-agent/data/processed/stability_transitions_MLB.csv")
    
    # Filter to focused cohorts only (good/excellent angles)
    focused_trans <- transitions_df %>%
      filter(prior_interaction_cohort != "Excluded from Analysis")
    
    cat("\n=== MLB STABILITY SUMMARY (FOCUSED COHORTS) ===\n")
    cat("\nAnalyzing", nrow(focused_trans), "transitions for players with Good/Excellent angles.\n\n")
    
    by_cohort <- focused_trans %>%
      group_by(prior_interaction_cohort) %>%
      summarise(
        n = n(),
        mean_angles_score = mean(prior_angles_score, na.rm = TRUE),
        mean_ss_pct = mean(prior_ss_pct, na.rm = TRUE),
        mean_ss_change = mean(ss_pct_yoy_change, na.rm = TRUE),
        pct_regressed_ss_5pp = 100 * mean(regressed_ss_5pp, na.rm = TRUE),
        mean_angles_score_change = mean(angles_score_yoy_change, na.rm = TRUE),
        pct_regressed_angles = 100 * mean(regressed_angles_score, na.rm = TRUE),
        pct_improved_angles = 100 * mean(improved_angles_score, na.rm = TRUE),
        num_good_ss = sum(stayed_good_ss, na.rm = TRUE),
        num_good_angles = sum(stayed_good_angles, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      arrange(desc(n))

      by_ss <- transitions_df %>%
      group_by(prior_swspt_cohort) %>%
      summarise(
        n = n(),
        mean_angles_score = mean(prior_angles_score, na.rm = TRUE),
        mean_ss_pct = mean(prior_ss_pct, na.rm = TRUE),
        mean_ss_change = mean(ss_pct_yoy_change, na.rm = TRUE),
        pct_regressed_ss_5pp = 100 * mean(regressed_ss_5pp, na.rm = TRUE),
        mean_angles_score_change = mean(angles_score_yoy_change, na.rm = TRUE),
        pct_regressed_angles = 100 * mean(regressed_angles_score, na.rm = TRUE),
        pct_improved_angles = 100 * mean(improved_angles_score, na.rm = TRUE),
        num_good_ss = sum(stayed_good_ss, na.rm = TRUE),
        num_good_angles = sum(stayed_good_angles, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      arrange(desc(n))
    print(by_cohort)
    
  } else {
    cat("\nNo multi-year transitions found.\n")
    transitions_df <- tibble()
  }
  
  cat("\n✓ Step 3 (MLB) complete.\n")
  return(transitions_df)
}


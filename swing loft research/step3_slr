# 1. Find all players with at least one poor loft season
poor_loft_players <- angles_data %>%
  filter(loft_cohort == "Poor Loft") %>%
  distinct(last_first_name)

# 2. For each of those players, calculate their poor-loft rate across ALL seasons
poor_loft_persistence <- angles_data %>%
  filter(last_first_name %in% poor_loft_players$last_first_name) %>%
  group_by(last_first_name) %>%
  summarise(
    n_seasons = n(),
    n_poor_loft_seasons = sum(loft_cohort == "Poor Loft", na.rm = TRUE),
    pct_poor_loft_seasons = 100 * n_poor_loft_seasons / n_seasons,
    seasons_list = paste(season, collapse = ", "),
    poor_loft_seasons = paste(season[poor_loft == TRUE], collapse = ", ")
  ) %>%
  arrange(desc(pct_poor_loft_seasons))

# 3. Segment them
segments <- poor_loft_persistence %>%
  mutate(
    persistence_type = case_when(
      pct_poor_loft_seasons == 100 ~ "Chronic (every year)",
      pct_poor_loft_seasons >= 66 ~ "Frequent (2+ of 3 years)",
      pct_poor_loft_seasons >= 33 ~ "Occasional (1-2 seasons)",
      TRUE ~ "One-timer"
    )
  )

# Summary
summary_by_type <- segments %>%
  group_by(persistence_type) %>%
  summarise(
    n_hitters = n(),
    pct_of_poor_loft_hitters = 100 * n() / nrow(segments),
    mean_seasons = mean(n_seasons),
    mean_pct_poor_loft = mean(pct_poor_loft_seasons),
    examples = paste(head(batter_name, 3), collapse = ", ")
  )

  chronic_loft <- poor_loft_persistence %>%
  filter(n_seasons > 2 | (n_seasons == 2 & pct_poor_loft_seasons == 100)) %>%
  mutate(state_cohort = ifelse(pct_poor_loft_seasons >= 65,"chronic","transient"))

full_persist <- left_join(angles_data,chronic_loft,by=c("last_first_name"))


# 3. For each player, calculate angles_score consistency
angles_consistency <- angles_data %>%
  group_by(last_first_name) %>%
  summarise(
    mean_angles_score = mean(angles_score, na.rm = TRUE),
    sd_angles_score = sd(angles_score, na.rm = TRUE),
    cv_angles_score = sd_angles_score / mean_angles_score,  # Coefficient of variation
    mean_ss_rank = mean(sweet_spot_pct_rank, na.rm = TRUE),
    sd_ss_rank = sd(sweet_spot_pct_rank, na.rm = TRUE),
    cv_ss_rank = sd_ss_rank / mean_ss_rank,
    mean_avg_la_rank = mean(launch_angle_avg_rank, na.rm = TRUE),
    sd_avg_la_rank = sd(launch_angle_avg_rank, na.rm = TRUE),
    cv_avg_la_rank = sd_avg_la_rank / mean_avg_la_rank,
    mean_hhla_rank = mean(hard_hit_pct_rank, na.rm = TRUE),
    sd_hhla_rank = sd(hard_hit_pct_rank, na.rm = TRUE),
    cv_hhla_rank = sd_hhla_rank / mean_hhla_rank
  ) %>%
  left_join(chronic_loft, by = "last_first_name")

# 4. Compare chronic vs transient
consistency_by_type <- angles_consistency %>%
  filter(state_cohort %in% c("chronic", "transient")) %>%
  group_by(state_cohort) %>%
  summarise(
    n_players = n(),
    mean_mean_angles = round(mean(mean_angles_score, na.rm = TRUE), 2),
    mean_sd_angles = round(mean(sd_angles_score, na.rm = TRUE), 2),
    mean_cv_angles = round(mean(cv_angles_score, na.rm = TRUE), 2),
    median_sd_angles = round(median(sd_angles_score, na.rm = TRUE), 2),
    median_cv_angles = round(median(cv_angles_score, na.rm = TRUE), 2), 
    mean_mean_ss_rank = round(mean(mean_ss_rank, na.rm = TRUE), 2),
    mean_sd_ss_rank = round(mean(sd_ss_rank, na.rm = TRUE), 2),
    mean_cv_ss_rank = round(mean(cv_ss_rank, na.rm = TRUE), 2),
    mean_mean_avg_la_rank = round(mean(mean_avg_la_rank, na.rm = TRUE), 2),
    mean_sd_avg_la_rank = round(mean(sd_avg_la_rank, na.rm = TRUE), 2),
    mean_cv_avg_la_rank = round(mean(cv_avg_la_rank, na.rm = TRUE), 2),
    mean_mean_hhla_rank = round(mean(mean_hhla_rank, na.rm = TRUE), 2),
    mean_sd_hhla_rank = round(mean(sd_hhla_rank, na.rm = TRUE), 2),
    mean_cv_hhla_rank = round(mean(cv_hhla_rank, na.rm = TRUE), 2)
  ) %>%
  select(state_cohort,n_players,mean_mean_angles,mean_sd_angles,mean_mean_ss_rank,
          mean_sd_ss_rank,mean_mean_avg_la_rank,mean_sd_avg_la_rank,
